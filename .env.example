# MySQL (Hostinger) — habilita "MySQL remoto" en hPanel antes de configurar esto
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Wompi (https://comercios.wompi.co)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_ENV=sandbox

# URL pública del sitio (usada para armar el redirect-url del checkout de Wompi)
PUBLIC_SITE_URL=https://davanalyst.com
